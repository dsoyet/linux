# https://learn.microsoft.com/en-us/powershell/
Set-PSReadLineOption -EditMode Emacs

# 检查是否在 PowerShell 5.1 中 PSScriptRoot 是否可用，如果不可用则用 MyInvocation 获取
if (-not $PSScriptRoot) {
    $PSScriptRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
}

{{- if eq .chezmoi.windowsVersion.productName "Windows 10 Enterprise LTSC 2024" }}
$env:Path += ';E:\Mpv;E:\Telegram;E:\Vim\bin;E:\HD\Rust\cargo\bin;E:\HD\Js;E:\HD\Js\bootstrap;C:\Program Files\Git\usr\bin;C:\Program Files\VMware\VMware Workstation' 
{{- end }}

{{- if eq .chezmoi.windowsVersion.productName "Windows Server 2022 Datacenter" }}
$env:Path = 'C:\Users\Administrator\Downloads\chezmoi;' + $env:Path
{{- end }}

function Prompt {
    $currentPath = (Get-Location).Path.Replace($HOME, '~')
    $IsAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    $esc = [char]27
    $color = if ($IsAdmin) { 31 } else { 32 }
    "[$esc[$color`m$env:COMPUTERNAME$esc[0m] $currentPath> "
}

function which { 
    Get-Command $args | Select-Object -ExpandProperty Definition 
}

function htop { 
    btm -b 
}

function env { 
    Get-ChildItem Env: 
}

function ls { 
    lsd -lA $args
}

function ll { 
    lsd -1A $args
}

function xdg { 
    lsd --tree --depth 1 -A ~/AppData/Local ~/AppData/LocalLow ~/AppData/Roaming 
}

{{- if eq .chezmoi.windowsVersion.productName "Windows 10 Enterprise LTSC 2024" }}
function cz { 
    E:\Mpv\tools\chezmoi.exe --config "E:\Job\chezmoi\chezmoi.toml" $args 
}

function npp { 
    E:\Notepad\notepad++.exe $args 
}

function vim {
    $root = "E:\Vim"
    $env:XDG_CONFIG_HOME = "$root\home\.config"
    $env:XDG_DATA_HOME   = "$root\home\.local\share"
    $env:XDG_STATE_HOME  = "$root\home\.local\state"
    $env:XDG_CACHE_HOME  = "$root\home\.cache"
    $exe = if (Test-Path "$root\bin\nvim.exe") { "$root\bin\nvim.exe" } else { "$root\nvim.exe" }
    if (-not (Test-Path $exe)) { Write-Error "找不到 nvim.exe"; return }
    & $exe $args
}
{{- end }}

